node_modules/
.astro/

# `docs/` (sortie de `npm run build`, voir astro.config.mjs `outDir`) N'EST PAS
# ignoré : GitHub Pages sert ce dossier directement depuis `main` (Settings →
# Pages → Deploy from a branch → /docs) — il doit donc être commité à chaque
# publication (voir scripts/save.sh).
.env
.env.*
!.env.example
.DS_Store
*.log
.vercel
.netlify

# Marqueur local de dernière synchronisation (propre à chaque machine)
.last-sync

# Généré au build par scripts/build-season.mjs (US-032) — recalculé à chaque build,
# ne vaut pas la peine d'être suivi en git.
src/data/build-meta.generated.json

# src/data/meteo-marees.generated.json N'EST PAS ignoré : rafraîchi quotidiennement
# par .github/workflows/fetch-tides.yml et committé, pour que la donnée survive même
# tant qu'aucun hébergement avec rebuild programmé n'est branché (US-009).
