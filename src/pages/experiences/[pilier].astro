---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PlaceholderImage from '@/components/PlaceholderImage.astro';
import { maison, lienAirbnb } from '@/data/maison';
import { experiences } from '@/data/experiences';
import { fichesLieux } from '@/data/decouvrir';

export function getStaticPaths() {
  return experiences.map((e) => ({ params: { pilier: e.slug }, props: { experience: e } }));
}

const { experience } = Astro.props as { experience: (typeof experiences)[number] };
const canonical = new URL(`/experiences/${experience.slug}/`, Astro.site).toString();
const decouvrirLies = experience.decouvrirLies.map((slug) => fichesLieux.find((f) => f.slug === slug)).filter(Boolean) as typeof fichesLieux;

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: experience.faq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.r },
  })),
};

const touristTripJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'TouristTrip',
  name: experience.titre,
  description: experience.promesse,
  url: canonical,
  itinerary: experience.propositions.map((p) => ({ '@type': 'TouristAttraction', name: p.titre })),
};
---

<BaseLayout
  title={experience.titre}
  description={experience.promesse}
  crumbs={[{ label: 'Expériences', href: '/experiences/' }, { label: experience.titre, href: `/experiences/${experience.slug}/` }]}
  jsonLd={[faqJsonLd, touristTripJsonLd]}
  ogImage={`/medias/placeholder/placeholder-${experience.heroSlug}.svg`}
>
  <!-- 1. Hero thématique -->
  <section class="relative">
    <PlaceholderImage slug={experience.heroSlug} ratio="16x9" alt={`${experience.titre} (visuel provisoire)`} loading="eager" class="h-[45vh] min-h-[300px] w-full object-cover" />
    <div class="absolute inset-0 flex items-end bg-gradient-to-t from-ink/70 via-ink/10 to-transparent">
      <div class="mx-auto w-full max-w-4xl px-4 pb-8 text-white sm:px-6">
        <p class="text-sm font-semibold uppercase tracking-wide text-white/80">{experience.pilier}</p>
        <h1 class="mt-2 font-display text-4xl font-semibold sm:text-5xl">{experience.titre}</h1>
      </div>
    </div>
  </section>

  <div class="mx-auto max-w-3xl space-y-14 px-4 py-14 sm:px-6">
    <!-- 2. Promesse -->
    <p class="font-display text-xl leading-snug">{experience.promesse}</p>

    <!-- 3. Depuis la maison -->
    <section aria-labelledby="depuis-titre" class="rounded-lg border border-border bg-surface-alt p-5">
      <h2 id="depuis-titre" class="text-sm font-semibold uppercase tracking-wide text-ink-muted">Depuis la maison</h2>
      <p class="mt-2 text-sm">{experience.depuisLaMaison}</p>
    </section>

    <!-- 4. Propositions concrètes -->
    <section aria-labelledby="propositions-titre">
      <h2 id="propositions-titre" class="font-display text-2xl font-semibold">Propositions concrètes</h2>
      <div class="mt-6 overflow-x-auto">
        <table class="w-full min-w-[560px] border-collapse text-sm">
          <thead>
            <tr class="border-b border-border text-left text-xs uppercase tracking-wide text-ink-muted">
              <th class="py-2 pr-4">Proposition</th>
              <th class="py-2 pr-4">Durée</th>
              <th class="py-2 pr-4">Difficulté</th>
              <th class="py-2 pr-4">Saison idéale</th>
              <th class="py-2">Coût</th>
            </tr>
          </thead>
          <tbody>
            {
              experience.propositions.map((p) => (
                <tr class="border-b border-border/60">
                  <td class="py-2 pr-4 font-semibold">{p.titre}</td>
                  <td class="py-2 pr-4">{p.duree}</td>
                  <td class="py-2 pr-4">{p.difficulte}</td>
                  <td class="py-2 pr-4">{p.saisonIdeale}</td>
                  <td class="py-2">{p.cout}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>

    <!-- 5. Encadré pratique -->
    <section aria-labelledby="pratique-titre" class="rounded-lg border border-border bg-surface p-5">
      <h2 id="pratique-titre" class="font-display text-xl font-semibold">Encadré pratique</h2>
      <dl class="mt-3 space-y-3 text-sm">
        <div>
          <dt class="font-semibold">Matériel</dt>
          <dd class="text-ink-muted">{experience.encadrePratique.materiel.join(', ')}</dd>
        </div>
        <div>
          <dt class="font-semibold">Réservations</dt>
          <dd class="text-ink-muted">{experience.encadrePratique.reservations}</dd>
        </div>
        <div>
          <dt class="font-semibold">Prestataires</dt>
          <dd class="text-ink-muted">{experience.encadrePratique.prestataires}</dd>
        </div>
      </dl>
    </section>

    <!-- 6. FAQ -->
    <section aria-labelledby="faq-titre">
      <h2 id="faq-titre" class="font-display text-2xl font-semibold">Questions fréquentes</h2>
      <div class="mt-4 divide-y divide-border rounded-lg border border-border">
        {
          experience.faq.map((item) => (
            <details class="group p-4">
              <summary class="cursor-pointer list-none font-semibold marker:content-none">{item.q}</summary>
              <p class="mt-2 text-sm text-ink-muted">{item.r}</p>
            </details>
          ))
        }
      </div>
    </section>

    <!-- 7. Liens vers /decouvrir/ -->
    <section aria-labelledby="decouvrir-titre">
      <h2 id="decouvrir-titre" class="font-display text-2xl font-semibold">À combiner avec</h2>
      <ul class="mt-4 grid gap-3 sm:grid-cols-3">
        {
          decouvrirLies.map((lieu) => (
            <li>
              <a href={`/decouvrir/${lieu.slug}/`} class="block rounded-lg border border-border bg-surface p-4 text-sm font-semibold hover:bg-surface-alt">
                {lieu.nom}
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- 8. CTA -->
    <section class="rounded-xl bg-accent px-6 py-10 text-center text-white">
      <h2 class="font-display text-2xl font-semibold">Envie d'en profiter depuis la maison ?</h2>
      <p class="mt-2 text-white/90">{maison.nom} — {maison.capacite.voyageurs} personnes, à {maison.distances.mer.duree} de la mer.</p>
      <div class="mt-6 flex justify-center">
        <a
          href={lienAirbnb(`experience-${experience.slug}`)}
          target="_blank"
          rel="noopener noreferrer nofollow"
          data-analytics-event="sortie_airbnb"
          class="rounded-md bg-white px-5 py-3 text-sm font-semibold text-accent hover:opacity-90"
        >
          Voir sur Airbnb
        </a>
      </div>
    </section>
  </div>
</BaseLayout>
