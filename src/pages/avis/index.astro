---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Cta from '@/components/Cta.astro';
import AvisCard from '@/components/AvisCard.astro';
import { maison } from '@/data/maison';
import { avis } from '@/data/avis';
---

<BaseLayout
  title="Avis voyageurs"
  description={`Avis voyageurs sur ${maison.nom} — uniquement des avis réels et attribués, jamais de faux avis.`}
  crumbs={[{ label: 'Avis', href: '/avis/' }]}
>
  <div class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
    <header>
      <h1 class="font-display text-4xl font-semibold">Avis voyageurs</h1>
      <p class="mt-3 text-ink-muted">
        Ce site n'affiche que des avis réels, sourcés et attribués. Publier un faux avis n'est pas seulement contraire à l'éthique du site — c'est
        une pratique sanctionnée (DGCCRF, PRD §15.2). Nous préférons ne rien afficher plutôt que d'inventer.
      </p>
    </header>

    {
      avis.length > 0 ? (
        <section aria-labelledby="avis-titre" class="mt-10">
          <h2 id="avis-titre" class="sr-only">
            Avis
          </h2>
          <div class="grid gap-4 sm:grid-cols-2">
            {avis.map((a) => (
              <AvisCard avis={a} />
            ))}
          </div>
        </section>
      ) : (
        <section aria-labelledby="statut-titre" class="mt-10 rounded-lg border border-dashed border-border p-6 text-center">
          <h2 id="statut-titre" class="font-display text-xl font-semibold">
            Aucun avis pour l'instant
          </h2>
          <p class="mt-2 text-sm text-ink-muted">
            Les avis publiés ici seront importés à la main depuis les plateformes de réservation ({maison.hotes.map((h) => h.prenom).join(' & ')} —
            statut{maison.superhost ? ' Superhost' : ''}), texte intégral et auteur inchangés. En attendant, consultez les avis directement sur la
            plateforme de réservation.
          </p>
          <div class="mt-4 flex justify-center">
            <Cta campagne="avis-page" />
          </div>
        </section>
      )
    }
  </div>
</BaseLayout>
