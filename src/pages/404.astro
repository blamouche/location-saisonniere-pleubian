---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { withBase } from '@/lib/base-path';

const pagesPrincipales = [
  { href: '/', label: 'Accueil' },
  { href: '/la-maison/', label: 'La maison' },
  { href: '/la-maison/galerie/', label: 'Galerie photo' },
  { href: '/reserver/', label: 'Réserver' },
  { href: '/contact/', label: 'Contact' },
  { href: '/legal/', label: 'Mentions légales' },
];
---

<BaseLayout title="Page introuvable" description="Cette page n'existe pas ou plus.">
  <div class="mx-auto max-w-2xl px-4 py-20 text-center sm:px-6">
    <p class="font-display text-6xl font-semibold text-accent">404</p>
    <h1 class="mt-4 font-display text-3xl font-semibold">Cette page n'existe pas (ou plus)</h1>
    <p class="mt-3 text-ink-muted">Le lien est peut-être obsolète. Voici les pages principales du site :</p>

    <ul class="mt-8 grid gap-3 sm:grid-cols-2">
      {
        pagesPrincipales.map((p) => (
          <li>
            <a href={withBase(p.href)} class="block rounded-lg border border-border px-4 py-3 font-semibold hover:bg-surface-alt">
              {p.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>
