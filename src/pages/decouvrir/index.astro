---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PlaceholderImage from '@/components/PlaceholderImage.astro';
import { fichesLieux } from '@/data/decouvrir';
import { lieuxAProximite } from '@/data/a-proximite';
import { withBase } from '@/lib/base-path';
---

<BaseLayout
  title="Découvrir la Presqu'île sauvage"
  description="Le guide du territoire autour de la Maison Od Joge : Sillon de Talbert, Bréhat, Tréguier, Paimpol, Côte de Granit Rose et plus."
  crumbs={[{ label: 'Découvrir', href: '/decouvrir/' }]}
>
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <header>
      <h1 class="font-display text-4xl font-semibold">Découvrir la Presqu'île sauvage</h1>
      <p class="mt-3 max-w-2xl text-ink-muted">Le guide du territoire — {fichesLieux.length} fiches de lieux, rédigées pour préparer un vrai séjour, pas pour remplir un portail.</p>
    </header>

    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        fichesLieux.map((fiche) => (
          <a href={withBase(`/decouvrir/${fiche.slug}/`)} class="group overflow-hidden rounded-xl border border-border bg-surface">
            <PlaceholderImage slug={fiche.heroSlug} ratio="4x5" alt={`${fiche.nom} (visuel provisoire)`} class="h-48 w-full object-cover" />
            <div class="p-4">
              <p class="font-display font-semibold group-hover:text-accent">{fiche.nom}</p>
              <p class="mt-1 text-xs text-ink-muted">{fiche.resume.ou}</p>
            </div>
          </a>
        ))
      }
    </div>

    <section class="mt-16" aria-labelledby="proximite-titre">
      <h2 id="proximite-titre" class="font-display text-2xl font-semibold">À proximité — jusqu'à 1h de route</h2>
      <p class="mt-2 max-w-2xl text-sm text-ink-muted">
        Au-delà de la Presqu'île sauvage, ces lieux restent accessibles en moins d'une heure de route (PRD §1.2). Temps de trajet exacts à vérifier
        porte-à-porte avant publication définitive.
      </p>
      <ul class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          lieuxAProximite.map((lieu) => (
            <li>
              {lieu.lien ? (
                <a href={withBase(`/decouvrir/${lieu.lien}/`)} class="block rounded-lg border border-border bg-surface p-4 hover:bg-surface-alt">
                  <p class="font-display font-semibold">{lieu.nom}</p>
                  <p class="mt-1 text-sm text-ink-muted">{lieu.description}</p>
                </a>
              ) : (
                <a href={lieu.lienExterne} target="_blank" rel="noopener noreferrer nofollow" class="block rounded-lg border border-dashed border-border bg-surface p-4 hover:bg-surface-alt">
                  <p class="font-display font-semibold">{lieu.nom} ↗</p>
                  <p class="mt-1 text-sm text-ink-muted">{lieu.description}</p>
                  <p class="mt-2 text-xs text-ink-muted">Pas encore de fiche dédiée — lien vers une source externe.</p>
                </a>
              )}
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</BaseLayout>
