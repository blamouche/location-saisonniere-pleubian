---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PlaceholderImage from '@/components/PlaceholderImage.astro';
import { fichesLieux } from '@/data/decouvrir';
import { experiences } from '@/data/experiences';
import { buildDate } from '@/lib/build-date';

export function getStaticPaths() {
  return fichesLieux.map((f) => ({ params: { lieu: f.slug }, props: { fiche: f } }));
}

const { fiche } = Astro.props as { fiche: (typeof fichesLieux)[number] };
const canonical = new URL(`/decouvrir/${fiche.slug}/`, Astro.site).toString();
const liensCombiner = fiche.aCombinerAvec.map((slug) => fichesLieux.find((f) => f.slug === slug)).filter(Boolean) as typeof fichesLieux;
const experienceLiee = experiences.find((e) => e.slug === fiche.experienceLiee);

const placeJsonLd = {
  '@context': 'https://schema.org',
  '@type': ['TouristAttraction', 'Place'],
  name: fiche.nom,
  url: canonical,
  geo: { '@type': 'GeoCoordinates', latitude: fiche.geo.latitude, longitude: fiche.geo.longitude },
  isAccessibleForFree: fiche.resume.gratuitPayant.toLowerCase().startsWith('gratuit'),
  dateModified: buildDate.toISOString(),
  // Alignement Wikidata (US-057) : uniquement les QID vérifiés via l'API Wikidata,
  // jamais un identifiant deviné.
  ...(fiche.wikidata ? { sameAs: fiche.wikidata.map((qid) => `https://www.wikidata.org/wiki/${qid}`) } : {}),
};
---

<BaseLayout
  title={fiche.nom}
  description={fiche.corps[0]}
  crumbs={[{ label: 'Découvrir', href: '/decouvrir/' }, { label: fiche.nom, href: `/decouvrir/${fiche.slug}/` }]}
  jsonLd={placeJsonLd}
  ogImage={`/medias/placeholder/placeholder-${fiche.heroSlug}.svg`}
>
  <section class="relative">
    <PlaceholderImage slug={fiche.heroSlug} ratio="16x9" alt={`${fiche.nom} (visuel provisoire)`} loading="eager" class="h-[40vh] min-h-[280px] w-full object-cover" />
    <div class="absolute inset-0 flex items-end bg-gradient-to-t from-ink/70 via-ink/10 to-transparent">
      <div class="mx-auto w-full max-w-3xl px-4 pb-8 text-white sm:px-6">
        <h1 class="font-display text-4xl font-semibold sm:text-5xl">{fiche.nom}</h1>
      </div>
    </div>
  </section>

  <div class="mx-auto max-w-3xl space-y-12 px-4 py-14 sm:px-6">
    <!-- L'essentiel (US-051, GEO) : résumé autonome de 40-60 mots, citable hors contexte. -->
    <section aria-labelledby="essentiel-titre" class="rounded-lg border border-border bg-surface-alt p-5">
      <h2 id="essentiel-titre" class="text-xs font-semibold uppercase tracking-wide text-ink-muted">L'essentiel</h2>
      <p class="mt-2 text-sm">{fiche.essentiel}</p>
    </section>

    <!-- Résumé factuel, en tableau (US-052) -->
    <section aria-labelledby="resume-titre">
      <h2 id="resume-titre" class="sr-only">Résumé factuel</h2>
      <div class="overflow-x-auto rounded-lg border border-border">
        <table class="w-full text-sm">
          <tbody>
            <tr class="border-b border-border"><th scope="row" class="w-1/3 bg-surface-alt p-3 text-left text-xs font-semibold uppercase tracking-wide text-ink-muted">Où</th><td class="p-3">{fiche.resume.ou}</td></tr>
            <tr class="border-b border-border"><th scope="row" class="bg-surface-alt p-3 text-left text-xs font-semibold uppercase tracking-wide text-ink-muted">Durée de visite</th><td class="p-3">{fiche.resume.dureeVisite}</td></tr>
            <tr class="border-b border-border"><th scope="row" class="bg-surface-alt p-3 text-left text-xs font-semibold uppercase tracking-wide text-ink-muted">Gratuit ou payant</th><td class="p-3">{fiche.resume.gratuitPayant}</td></tr>
            <tr class="border-b border-border"><th scope="row" class="bg-surface-alt p-3 text-left text-xs font-semibold uppercase tracking-wide text-ink-muted">Meilleure saison</th><td class="p-3">{fiche.resume.meilleureSaison}</td></tr>
            <tr><th scope="row" class="bg-surface-alt p-3 text-left text-xs font-semibold uppercase tracking-wide text-ink-muted">Accessible poussette / PMR</th><td class="p-3">{fiche.resume.accessiblePMR}</td></tr>
          </tbody>
        </table>
      </div>
      <p class="mt-3 text-xs text-ink-muted">Temps de trajet depuis la maison : à vérifier porte-à-porte avant publication définitive (convention du dépôt).</p>
    </section>

    <!-- Corps rédigé -->
    <section aria-labelledby="corps-titre">
      <h2 id="corps-titre" class="font-display text-2xl font-semibold">Pourquoi visiter {fiche.nom} ?</h2>
      <div class="mt-4 space-y-4 text-sm leading-relaxed">
        {fiche.corps.map((p) => <p set:html={p.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')} />)}
      </div>
    </section>

    <!-- Conseil pratique -->
    <section aria-labelledby="conseil-titre" class="rounded-lg border border-dashed border-accent bg-accent-soft p-5">
      <h2 id="conseil-titre" class="font-display text-xl font-semibold">Quel est le meilleur conseil pour visiter {fiche.nom} ?</h2>
      <p class="mt-2 text-sm">{fiche.conseilPratique}</p>
    </section>

    <!-- À combiner avec -->
    <section aria-labelledby="combiner-titre">
      <h2 id="combiner-titre" class="font-display text-2xl font-semibold">Que voir à proximité de {fiche.nom} ?</h2>
      <ul class="mt-4 grid gap-3 sm:grid-cols-3">
        {
          liensCombiner.map((lieu) => (
            <li>
              <a href={`/decouvrir/${lieu.slug}/`} class="block rounded-lg border border-border bg-surface p-4 text-sm font-semibold hover:bg-surface-alt">
                {lieu.nom}
              </a>
            </li>
          ))
        }
        {
          experienceLiee && (
            <li>
              <a href={`/experiences/${experienceLiee.slug}/`} class="block rounded-lg border border-border bg-surface p-4 text-sm font-semibold hover:bg-surface-alt">
                {experienceLiee.titre}
              </a>
            </li>
          )
        }
      </ul>
    </section>
  </div>
</BaseLayout>
