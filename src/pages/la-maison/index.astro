---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PlaceholderImage from '@/components/PlaceholderImage.astro';
import { maison } from '@/data/maison';
import { lodgingBusinessJsonLd } from '@/lib/jsonld';

const canonical = new URL('/la-maison/', Astro.site).toString();

const pieces = [
  { slug: 'salon', titre: 'Le salon', description: 'Poêle à bois, canapés, lumière naturelle.' },
  { slug: 'cuisine', titre: 'La cuisine', description: 'Équipée, lave-vaisselle, cafetière manuelle et machine à espresso.' },
  { slug: 'chambre-4-rdc', titre: 'Chambre RDC', description: 'Lit double, accessible sans escalier — salle de bain avec douche à l’italienne au rdc.' },
  { slug: 'chambre-1-etage', titre: 'Chambre à l’étage', description: 'Lit double, sous les combles.' },
  { slug: 'chambre-3-etage', titre: 'Chambre avec lit gigogne', description: 'Idéale pour deux enfants ou un couple supplémentaire.' },
  { slug: 'espace-travail', titre: 'Espace de travail dédié', description: 'WiFi, bureau au calme — pensé pour le télétravail.' },
  { slug: 'jardin', titre: 'Le jardin', description: 'Jardin privatif clos, sans vis-à-vis, adapté aux enfants en bas âge.' },
  { slug: 'facade', titre: 'Extérieur & stationnement', description: 'Stationnement gratuit en cour et devant la maison.' },
];

const equipementsLabels: Record<string, string> = {
  confort: 'Confort',
  cuisine: 'Cuisine',
  exterieur: 'Extérieur',
  securite: 'Sécurité',
  accessibilite: 'Accessibilité',
};
---

<BaseLayout
  title="La maison"
  description={`Visite guidée de ${maison.nom} : ${maison.capacite.chambres} chambres, ${maison.capacite.sallesDeBain} salles de bain, jardin clos, équipements complets et configurations de couchage pour ${maison.capacite.voyageurs} personnes.`}
  crumbs={[{ label: 'La maison', href: '/la-maison/' }]}
  jsonLd={lodgingBusinessJsonLd(canonical)}
>
  <div class="mx-auto max-w-6xl space-y-16 px-4 py-12 sm:px-6">
    <header>
      <h1 class="font-display text-4xl font-semibold">La maison</h1>
      <p class="mt-3 max-w-2xl text-ink-muted">
        {maison.capacite.voyageurs} voyageurs · {maison.capacite.chambres} chambres · {maison.capacite.couchages} lits · {maison.capacite.sallesDeBain} salles de bain{maison.capacite.wcSepare && ' + WC séparé'}.
      </p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href="/la-maison/galerie/" class="rounded-md border border-accent px-4 py-2 text-sm font-semibold text-accent hover:bg-accent-soft">Voir la galerie complète</a>
        <a href="/la-maison/pratique/" class="rounded-md border border-border px-4 py-2 text-sm font-semibold hover:bg-surface-alt">Infos pratiques &amp; arrivée</a>
      </div>
    </header>

    <!-- Visite pièce par pièce -->
    <section aria-labelledby="visite-titre">
      <h2 id="visite-titre" class="font-display text-2xl font-semibold">Visite, pièce par pièce</h2>
      <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          pieces.map((piece) => (
            <figure class="overflow-hidden rounded-lg border border-border bg-surface">
              <PlaceholderImage slug={piece.slug} ratio="4x5" alt={`${piece.titre} (visuel provisoire)`} class="w-full object-cover" />
              <figcaption class="p-3">
                <p class="font-semibold">{piece.titre}</p>
                <p class="mt-1 text-sm text-ink-muted">{piece.description}</p>
              </figcaption>
            </figure>
          ))
        }
      </div>
    </section>

    <!-- Plans -->
    <section aria-labelledby="plans-titre">
      <h2 id="plans-titre" class="font-display text-2xl font-semibold">Plan des deux niveaux</h2>
      <div class="mt-6 grid gap-6 sm:grid-cols-2">
        <figure class="overflow-hidden rounded-lg border border-border bg-surface">
          <PlaceholderImage slug="plan-rdc" ratio="1x1" alt="Plan schématique du rez-de-chaussée (visuel provisoire)" class="w-full object-cover" />
          <figcaption class="p-3 text-sm text-ink-muted">Rez-de-chaussée : chambre, salle de bain, cuisine, salon, poêle à bois.</figcaption>
        </figure>
        <figure class="overflow-hidden rounded-lg border border-border bg-surface">
          <PlaceholderImage slug="plan-etage" ratio="1x1" alt="Plan schématique de l'étage (visuel provisoire)" class="w-full object-cover" />
          <figcaption class="p-3 text-sm text-ink-muted">Étage : 3 chambres, salle de bain.</figcaption>
        </figure>
      </div>
    </section>

    <!-- Scénarios de couchage -->
    <section aria-labelledby="couchage-titre">
      <h2 id="couchage-titre" class="font-display text-2xl font-semibold">Qui dort où ?</h2>
      <ul class="mt-6 grid gap-4 sm:grid-cols-3">
        {
          maison.scenariosCouchage.map((scenario) => (
            <li class="rounded-lg border border-border bg-surface p-4 text-sm">{scenario}</li>
          ))
        }
      </ul>
    </section>

    <!-- Équipements -->
    <section aria-labelledby="equipements-titre">
      <h2 id="equipements-titre" class="font-display text-2xl font-semibold">Tous les équipements</h2>
      <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          Object.entries(maison.equipements).map(([categorie, items]) => (
            <div class="rounded-lg border border-border bg-surface p-4">
              <p class="font-display font-semibold">{equipementsLabels[categorie] ?? categorie}</p>
              <ul class="mt-2 space-y-1 text-sm text-ink-muted">
                {items.map((item) => (
                  <li>· {item}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Ce que la maison n'est pas -->
    <section aria-labelledby="honnetete-titre" class="rounded-lg border border-dashed border-border p-6">
      <h2 id="honnetete-titre" class="font-display text-xl font-semibold">Ce que la maison n'est pas</h2>
      <p class="mt-2 text-sm text-ink-muted">Par souci d'honnêteté (et pour éviter les mauvaises surprises) :</p>
      <ul class="mt-3 space-y-1 text-sm">
        {
          maison.cePasCest.map((item) => (
            <li>· {item}</li>
          ))
        }
      </ul>
    </section>
  </div>
</BaseLayout>
