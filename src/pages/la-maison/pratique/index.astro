---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { maison } from '@/data/maison';

const faq = [
  {
    q: "À quelle heure puis-je arriver ?",
    r: `L'arrivée est prévue à ${maison.horaires.arriveeBasseSaison} en basse saison et ${maison.horaires.arriveeHauteSaison} en haute saison. Le départ se fait avant ${maison.horaires.depart} (horaire à confirmer).`,
  },
  {
    q: 'Comment se passe l’arrivée ?',
    r: `L'arrivée est autonome, via une boîte à clés sécurisée — pas besoin d'attendre les hôtes sur place.`,
  },
  {
    q: 'Les animaux sont-ils acceptés ?',
    r: maison.animaux.acceptes ? 'Oui, les animaux sont acceptés.' : "Non, les animaux ne sont pas acceptés dans la maison.",
  },
  {
    q: 'Le stationnement est-il gratuit ?',
    r: `Oui, le stationnement est gratuit : ${maison.stationnement.emplacements.join(' ou ')}.`,
  },
  {
    q: 'Y a-t-il du WiFi et un espace de travail ?',
    r: "Oui, la maison dispose du WiFi et d'un espace de travail dédié, pensé pour le télétravail ou la workation. La maison est à la campagne : le signal (WiFi comme mobile) peut varier selon les opérateurs et les conditions.",
  },
  {
    q: 'Le ménage de fin de séjour est-il inclus ?',
    r: "Oui, le ménage de fin de séjour est inclus. Modalités de caution à confirmer avec les hôtes avant réservation (information non encore publiée sur le site).",
  },
  {
    q: 'Que faire en cas de problème pendant le séjour ?',
    r: 'Contactez Pauline & Maeva via les coordonnées communiquées à la réservation.',
  },
  {
    q: 'La maison est-elle accessible sans escalier ?',
    r: 'Une chambre et une salle de bain avec douche à l’italienne sont de plain-pied au rez-de-chaussée, sans escalier.',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.r },
  })),
};
---

<BaseLayout
  title="Infos pratiques"
  description="Arrivée, règlement intérieur et questions fréquentes pour préparer votre séjour à la Maison Od Joge."
  crumbs={[{ label: 'La maison', href: '/la-maison/' }, { label: 'Infos pratiques', href: '/la-maison/pratique/' }]}
  jsonLd={faqJsonLd}
>
  <div class="mx-auto max-w-3xl space-y-16 px-4 py-12 sm:px-6">
    <header>
      <h1 class="font-display text-4xl font-semibold">Infos pratiques</h1>
      <p class="mt-3 text-ink-muted">Tout ce qu'il faut savoir avant et pendant le séjour.</p>
    </header>

    <section aria-labelledby="arrivee-titre">
      <h2 id="arrivee-titre" class="font-display text-2xl font-semibold">Arrivée &amp; départ</h2>
      <dl class="mt-4 divide-y divide-border rounded-lg border border-border">
        <div class="flex justify-between gap-4 p-4 text-sm">
          <dt class="font-semibold">Arrivée (basse saison)</dt>
          <dd>{maison.horaires.arriveeBasseSaison}</dd>
        </div>
        <div class="flex justify-between gap-4 p-4 text-sm">
          <dt class="font-semibold">Arrivée (haute saison)</dt>
          <dd>{maison.horaires.arriveeHauteSaison}</dd>
        </div>
        <div class="flex justify-between gap-4 p-4 text-sm">
          <dt class="font-semibold">Départ</dt>
          <dd>{maison.horaires.depart}</dd>
        </div>
        <div class="flex justify-between gap-4 p-4 text-sm">
          <dt class="font-semibold">Modalité</dt>
          <dd>{maison.acces.modalite}</dd>
        </div>
      </dl>
    </section>

    <section aria-labelledby="reglement-titre">
      <h2 id="reglement-titre" class="font-display text-2xl font-semibold">Règlement intérieur</h2>
      <ul class="mt-4 space-y-2 text-sm">
        <li>· Animaux non acceptés</li>
        <li>· Merci de respecter le voisinage (maison en hameau résidentiel)</li>
        <li>· Fumer à l'extérieur uniquement</li>
        <li>· Ménage de fin de séjour inclus</li>
        <li class="text-ink-muted">Règlement complet (caution, taxe de séjour) à finaliser avec les hôtes avant mise en ligne — voir <a href="/reserver/" class="underline hover:text-accent">page réservation</a>.</li>
      </ul>
    </section>

    <section aria-labelledby="faq-titre">
      <h2 id="faq-titre" class="font-display text-2xl font-semibold">Questions fréquentes</h2>
      <div class="mt-4 divide-y divide-border rounded-lg border border-border">
        {
          faq.map((item) => (
            <details class="group p-4">
              <summary class="cursor-pointer list-none font-semibold marker:content-none">
                {item.q}
              </summary>
              <p class="mt-2 text-sm text-ink-muted">{item.r}</p>
            </details>
          ))
        }
      </div>
    </section>
  </div>
</BaseLayout>
