---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { maison } from '@/data/maison';
---

<BaseLayout
  title="Contact"
  description={`Une question sur ${maison.nom} ou votre séjour ? Écrivez directement à ${maison.hotes.map((h) => h.prenom).join(' & ')}.`}
  crumbs={[{ label: 'Contact', href: '/contact/' }]}
>
  <div class="mx-auto max-w-xl px-4 py-12 sm:px-6">
    <header>
      <h1 class="font-display text-4xl font-semibold">Contact</h1>
      <p class="mt-3 text-ink-muted">
        Une question avant de réserver, ou pendant votre séjour ? Écrivez à {maison.hotes.map((h) => h.prenom).join(' & ')} directement.
      </p>
    </header>

    <!--
      Formulaire au format Netlify Forms (détection statique via `data-netlify` +
      champ caché `form-name`) + honeypot anti-spam (US-021). Fonctionne tel quel si
      le site est hébergé sur Netlify (US-009) ; à adapter vers Formspree si
      l'hébergement final est Vercel.
    -->
    <form
      name="contact"
      method="POST"
      data-netlify="true"
      netlify-honeypot="societe"
      class="mt-8 space-y-5"
      novalidate
      id="contact-form"
    >
      <input type="hidden" name="form-name" value="contact" />
      <p class="hidden">
        <label>Ne pas remplir si vous êtes humain : <input name="societe" tabindex="-1" autocomplete="off" /></label>
      </p>

      <div>
        <label for="nom" class="block text-sm font-semibold">Nom</label>
        <input id="nom" name="nom" type="text" required autocomplete="name" class="mt-1 w-full rounded-md border border-border bg-surface px-3 py-2" aria-describedby="nom-erreur" />
        <p id="nom-erreur" class="mt-1 text-sm text-red-700" role="alert" hidden>Merci d'indiquer votre nom.</p>
      </div>

      <div>
        <label for="email" class="block text-sm font-semibold">Email</label>
        <input id="email" name="email" type="email" required autocomplete="email" class="mt-1 w-full rounded-md border border-border bg-surface px-3 py-2" aria-describedby="email-erreur" />
        <p id="email-erreur" class="mt-1 text-sm text-red-700" role="alert" hidden>Merci d'indiquer une adresse email valide.</p>
      </div>

      <div>
        <label for="message" class="block text-sm font-semibold">Message</label>
        <textarea id="message" name="message" rows="6" required class="mt-1 w-full rounded-md border border-border bg-surface px-3 py-2" aria-describedby="message-erreur"></textarea>
        <p id="message-erreur" class="mt-1 text-sm text-red-700" role="alert" hidden>Merci d'ajouter un message.</p>
      </div>

      <button type="submit" class="rounded-md bg-accent px-5 py-3 text-sm font-semibold text-white hover:opacity-90">Envoyer</button>

      <p id="contact-status" class="text-sm" role="status"></p>
    </form>

    <p class="mt-8 text-sm text-ink-muted">
      Vous pouvez aussi écrire directement à <a href={`mailto:${maison.contact.email}`} class="underline hover:text-accent">{maison.contact.email}</a>
      {maison.contact.noteTodo && <span class="block text-xs">({maison.contact.noteTodo})</span>}
    </p>
  </div>
</BaseLayout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = document.getElementById('contact-status');

  form?.addEventListener('submit', (event) => {
    let valide = true;
    (['nom', 'email', 'message'] as const).forEach((champ) => {
      const input = form.elements.namedItem(champ) as HTMLInputElement | HTMLTextAreaElement | null;
      const erreur = document.getElementById(`${champ}-erreur`);
      const ok = champ === 'email' ? !!input?.value.includes('@') : !!input?.value.trim();
      erreur?.toggleAttribute('hidden', ok);
      if (!ok) valide = false;
    });

    if (!valide) {
      event.preventDefault();
      if (status) status.textContent = 'Merci de corriger les champs en rouge.';
      return;
    }

    window.dispatchEvent(new CustomEvent('analytics', { detail: { event: 'envoi_contact' } }));
    // La soumission réelle est déléguée au navigateur (POST natif vers Netlify Forms
    // une fois le site déployé — voir commentaire dans le template).
  });
</script>
