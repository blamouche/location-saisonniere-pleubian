---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Cta from '@/components/Cta.astro';
import SeasonOfferBanner from '@/components/SeasonOfferBanner.astro';
import { maison } from '@/data/maison';

const saisonsLabels: Record<string, string> = {
  printemps: 'Printemps',
  ete: 'Été',
  automne: 'Automne',
  hiver: 'Hiver',
};

const faq = [
  { q: 'Quelle est la durée minimale de séjour ?', r: "À confirmer avec les hôtes — généralement plus courte hors haute saison." },
  { q: "Quelles sont les heures d'arrivée et de départ ?", r: `Arrivée à ${maison.horaires.arriveeBasseSaison} (basse saison) ou ${maison.horaires.arriveeHauteSaison} (haute saison), départ avant ${maison.horaires.depart} (à confirmer).` },
  { q: 'Une caution est-elle demandée ?', r: 'Modalités de caution fournies lors de la réservation.' },
  { q: 'Le ménage de fin de séjour est-il inclus dans le tarif ?', r: 'Oui, le ménage de fin de séjour est inclus.' },
  { q: 'La taxe de séjour est-elle incluse ?', r: 'Montant et mode de collecte à indiquer avant mise en ligne (obligation légale, PRD §15.2).' },
  { q: 'Comment réserver concrètement ?', r: "Via les boutons Airbnb / Booking ci-dessus, qui renvoient vers la plateforme de réservation officielle." },
  { q: 'Puis-je annuler ma réservation ?', r: "Les conditions d'annulation sont celles de la plateforme utilisée pour réserver (Airbnb ou Booking)." },
  { q: 'Les animaux sont-ils acceptés ?', r: maison.animaux.acceptes ? 'Oui.' : 'Non, les animaux ne sont pas acceptés.' },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.r },
  })),
};
---

<BaseLayout
  title="Réserver"
  description={`Tarifs indicatifs, disponibilités et liens de réservation pour ${maison.nom} — ${maison.capacite.voyageurs} personnes à ${maison.adresse.commune}.`}
  crumbs={[{ label: 'Réserver', href: '/reserver/' }]}
  jsonLd={faqJsonLd}
>
  <div class="mx-auto max-w-3xl space-y-16 px-4 py-12 sm:px-6">
    <header>
      <h1 class="font-display text-4xl font-semibold">Réserver</h1>
      <p class="mt-3 text-ink-muted">Tarifs indicatifs par saison, conditions de séjour et liens directs vers les plateformes de réservation.</p>
      <div class="mt-6">
        <Cta campagne="reserver-page" />
      </div>
      <div class="mt-6">
        <SeasonOfferBanner />
      </div>
    </header>

    <!-- Calendrier de disponibilité -->
    <section aria-labelledby="dispo-titre" class="rounded-lg border border-dashed border-border p-6">
      <h2 id="dispo-titre" class="font-display text-xl font-semibold">Disponibilités</h2>
      <p class="mt-2 text-sm text-ink-muted">
        Le calendrier de disponibilité en temps réel (import automatique depuis Airbnb/Booking) arrive au Lot 1 avancé — voir <code>US-020</code>.
        En attendant, merci de vérifier les disponibilités exactes directement sur Airbnb, ou de nous écrire via le <a href="/contact/" class="underline hover:text-accent">formulaire de contact</a>.
      </p>
    </section>

    <!-- Tarifs -->
    <section aria-labelledby="tarifs-titre">
      <h2 id="tarifs-titre" class="font-display text-2xl font-semibold">Tarifs indicatifs par saison</h2>
      <p class="mt-2 text-sm text-ink-muted">{maison.tarifs.noteTodo}</p>
      <dl class="mt-4 divide-y divide-border rounded-lg border border-border">
        {
          Object.entries(maison.tarifs.parSaison).map(([saison, tarif]) => (
            <div class="flex justify-between gap-4 p-4 text-sm">
              <dt class="font-semibold">{saisonsLabels[saison] ?? saison}</dt>
              <dd class="text-ink-muted">{tarif ?? 'À venir'}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <!-- Conditions -->
    <section aria-labelledby="conditions-titre">
      <h2 id="conditions-titre" class="font-display text-2xl font-semibold">Conditions</h2>
      <ul class="mt-4 space-y-2 text-sm text-ink-muted">
        <li>· Durée minimale de séjour : à confirmer</li>
        <li>· Arrivée {maison.horaires.arriveeBasseSaison} (basse saison) / {maison.horaires.arriveeHauteSaison} (haute saison) · Départ avant {maison.horaires.depart}</li>
        <li>· Caution : modalités fournies lors de la réservation</li>
        <li>· Ménage de fin de séjour : inclus</li>
        <li>· Taxe de séjour : montant à indiquer avant mise en ligne</li>
      </ul>
    </section>

    <!-- FAQ -->
    <section aria-labelledby="faq-titre">
      <h2 id="faq-titre" class="font-display text-2xl font-semibold">Questions fréquentes</h2>
      <div class="mt-4 divide-y divide-border rounded-lg border border-border">
        {
          faq.map((item) => (
            <details class="group p-4">
              <summary class="cursor-pointer list-none font-semibold marker:content-none">{item.q}</summary>
              <p class="mt-2 text-sm text-ink-muted">{item.r}</p>
            </details>
          ))
        }
      </div>
    </section>

    <section class="rounded-xl bg-accent px-6 py-10 text-center text-white">
      <h2 class="font-display text-2xl font-semibold">Prêt·e à réserver ?</h2>
      <div class="mt-6 flex justify-center">
        <Cta campagne="reserver-page-footer" variant="on-accent" />
      </div>
    </section>
  </div>
</BaseLayout>
