---
import SaisonView from '@/views/SaisonView.astro';
import { saisons, type SaisonId } from '@/data/saisons';
import { saisonSlugs } from '@/i18n/locales';

export function getStaticPaths() {
  return saisons.map((s) => ({
    params: { saison: s.id },
    props: {
      saisonId: s.id,
      alternates: { en: `/en/seasons/${saisonSlugs[s.id].en}/`, de: `/de/jahreszeiten/${saisonSlugs[s.id].de}/` },
    },
  }));
}

interface Props {
  saisonId: SaisonId;
  alternates: Partial<Record<'en' | 'de', string>>;
}

const { saisonId, alternates } = Astro.props as Props;
---

<SaisonView saisonId={saisonId} locale="fr" alternates={alternates} />
