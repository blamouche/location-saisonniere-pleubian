---
import BaseLayout from '@/layouts/BaseLayout.astro';
import FactBox from '@/components/FactBox.astro';
import Cta from '@/components/Cta.astro';
import PlaceholderImage from '@/components/PlaceholderImage.astro';
import HeroImage from '@/components/HeroImage.astro';
import EnCeMoment from '@/components/EnCeMoment.astro';
import { maison } from '@/data/maison';
import { getSaisonCourante } from '@/data/saisons';
import { lodgingBusinessJsonLd } from '@/lib/jsonld';
import { pointsInteret } from '@/data/points-interet';

const saison = getSaisonCourante();
const canonical = new URL('/', Astro.site).toString();

const chiffresCles = [
  { label: 'Voyageurs', value: `${maison.capacite.voyageurs}` },
  { label: 'Chambres', value: `${maison.capacite.chambres}` },
  { label: 'Salles de bain', value: `${maison.capacite.sallesDeBain}` },
  { label: 'Jardin', value: 'Clos, privatif, sans vis-à-vis' },
  { label: 'Mer à pied', value: maison.distances.mer.duree },
  { label: 'Statut', value: maison.superhost ? 'Superhost' : 'Hôte' },
];

const apercuMaison = [
  { slug: 'facade', label: 'Façade de la maison' },
  { slug: 'salon', label: 'Le salon' },
  { slug: 'cuisine', label: 'La cuisine équipée' },
  { slug: 'chambre-1-etage', label: 'Une des chambres' },
  { slug: 'jardin', label: 'Le jardin clos' },
  { slug: 'poele-a-bois', label: 'Le poêle à bois' },
];

const raisonsDeVenir = [
  { titre: 'Sport', description: 'GR34, EuroVelo 4, kayak et voile à quelques minutes.', lien: '/experiences/randonnee-gr34/' },
  { titre: 'Bien-être', description: 'Air marin iodé, marche méditative, bains de mer.', lien: '/experiences/bien-etre-air-marin/' },
  { titre: 'Déconnexion', description: 'Silence, ciel étoilé, poêle à bois, rythme des marées.', lien: '/experiences/deconnexion-slow/' },
  { titre: 'Air pur', description: 'Le littoral breton, un argument respiratoire concret.', lien: '/experiences/bien-etre-air-marin/' },
  { titre: 'Culture', description: 'Tréguier, Beauport, whisky breton, distillerie.', lien: '/experiences/culture-patrimoine/' },
];
---

<BaseLayout
  title={maison.nom}
  description={`${maison.slogan} — maison familiale ${maison.capacite.voyageurs} personnes à ${maison.adresse.commune} (${maison.adresse.codePostal}), Presqu'île sauvage, Côtes-d'Armor.`}
  jsonLd={lodgingBusinessJsonLd(canonical)}
>
  <!-- 1. Hero -->
  <section class="relative">
    <HeroImage
      saison={saison.id}
      alt={`Ambiance ${saison.label.toLowerCase()} sur la Presqu'île sauvage`}
      loading="eager"
      class="h-[70vh] min-h-[420px] w-full object-cover"
    />
    <div class="absolute inset-0 flex items-end bg-gradient-to-t from-ink/70 via-ink/10 to-transparent">
      <div class="mx-auto w-full max-w-6xl px-4 pb-10 text-white sm:px-6">
        <p class="text-sm font-semibold uppercase tracking-wide text-white/80">{saison.label} · {maison.adresse.commune}, {maison.adresse.departement}</p>
        <h1 class="mt-2 font-display text-4xl font-semibold sm:text-5xl">{maison.slogan}</h1>
        <p class="mt-3 max-w-xl text-white/90">
          Maison familiale de {maison.capacite.voyageurs} personnes entre {maison.adresse.commune} et {maison.adresse.lieuDit}, à {maison.distances.mer.duree} de la mer, sur la Presqu'île sauvage.
        </p>
        <div class="mt-6">
          <Cta campagne="accueil-hero" />
        </div>
      </div>
    </div>
  </section>

  <!-- 2. Barre de contexte -->
  <section class="border-b border-border bg-surface-alt">
    <div class="mx-auto flex max-w-6xl flex-wrap items-center gap-x-6 gap-y-2 px-4 py-3 text-sm text-ink-muted sm:px-6">
      <span><strong class="text-ink">Saison affichée :</strong> {saison.label} ({saison.periode})</span>
      <span aria-hidden="true">·</span>
      <span>Météo &amp; marées du jour : <em>bientôt disponibles</em> — pipeline de récupération en place (rebuild quotidien, dégradation gracieuse), API à connecter (US-032)</span>
    </div>
  </section>

  <div class="mx-auto max-w-6xl space-y-20 px-4 py-16 sm:px-6">
    <!-- 3. Pitch en 3 lignes -->
    <section aria-labelledby="pitch-titre">
      <h2 id="pitch-titre" class="sr-only">En bref</h2>
      <p class="max-w-3xl font-display text-xl leading-snug sm:text-2xl">
        {maison.nom} est une maison bretonne pour {maison.capacite.voyageurs} personnes, à {maison.adresse.commune} ({maison.adresse.codePostal}), sur la Presqu'île sauvage entre les estuaires du Trieux et du Jaudy. Jardin clos, poêle à bois, espace de travail dédié, et le Sillon de Talbert à quelques minutes.
      </p>
    </section>

    <!-- 4. Chiffres clés -->
    <section aria-labelledby="chiffres-titre">
      <h2 id="chiffres-titre" class="font-display text-2xl font-semibold">La maison en un coup d'œil</h2>
      <FactBox facts={chiffresCles} class="mt-6" />
    </section>

    <!-- 5. Aperçu de la maison -->
    <section aria-labelledby="apercu-titre">
      <div class="flex items-baseline justify-between gap-4">
        <h2 id="apercu-titre" class="font-display text-2xl font-semibold">Visite en images</h2>
        <a href="/la-maison/galerie/" class="text-sm font-semibold text-accent hover:underline">Voir toute la galerie →</a>
      </div>
      <div class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-3">
        {
          apercuMaison.map((photo) => (
            <PlaceholderImage slug={photo.slug} ratio="4x5" alt={`${photo.label} (visuel provisoire)`} class="w-full rounded-lg object-cover" />
          ))
        }
      </div>
    </section>

    <!-- 6. En ce moment à Pleubian (cœur du multi-saisons, US-033) -->
    <section>
      <EnCeMoment />
    </section>

    <!-- 7. Les 5 raisons de venir -->
    <section aria-labelledby="raisons-titre">
      <h2 id="raisons-titre" class="font-display text-2xl font-semibold">5 raisons de venir</h2>
      <p class="mt-2 text-sm text-ink-muted">Sport, bien-être, déconnexion, air pur, culture — cinq angles pour préparer un séjour.</p>
      <ul class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
        {
          raisonsDeVenir.map((raison) => (
            <li>
              <a href={raison.lien} class="block rounded-lg border border-border bg-surface p-4 hover:bg-surface-alt">
                <p class="font-display font-semibold">{raison.titre}</p>
                <p class="mt-1 text-sm text-ink-muted">{raison.description}</p>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- 8. Le territoire -->
    <section aria-labelledby="territoire-titre">
      <h2 id="territoire-titre" class="font-display text-2xl font-semibold">Le territoire, à quelques minutes</h2>
      <p class="mt-2 text-sm text-ink-muted">
        12 points d'intérêt du territoire — carte interactive MapLibre non encore implémentée (voir US-045) ; liste reliée aux fiches détaillées
        en attendant. Temps de trajet à vérifier porte-à-porte avant publication définitive.
      </p>
      <ul class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {
          pointsInteret.map((poi) => (
            <li>
              <a href={poi.lien} class="block rounded-lg border border-border bg-surface p-4 hover:bg-surface-alt">
                <p class="text-xs font-semibold uppercase tracking-wide text-accent">{poi.categorie}</p>
                <p class="mt-1 font-display font-semibold">{poi.nom}</p>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- 9. Avis -->
    <section aria-labelledby="avis-titre" class="rounded-lg border border-dashed border-border p-6 text-center">
      <h2 id="avis-titre" class="font-display text-2xl font-semibold">Avis voyageurs</h2>
      <p class="mt-2 text-sm text-ink-muted">
        Les avis publiés ici seront uniquement des avis réels et attribués, importés des plateformes de réservation (US-046). Aucun avis fictif n'est affiché en attendant.
      </p>
    </section>

    <!-- 10. Bandeau conversion -->
    <section aria-labelledby="conversion-titre" class="rounded-xl bg-accent px-6 py-10 text-center text-white">
      <h2 id="conversion-titre" class="font-display text-2xl font-semibold">Envie de réserver ?</h2>
      <p class="mt-2 text-white/90">Tarifs indicatifs et conditions complètes sur la page réservation.</p>
      <div class="mt-6 flex flex-wrap justify-center gap-3">
        <a href="/reserver/" class="rounded-md bg-white px-5 py-3 text-sm font-semibold text-accent hover:opacity-90">Voir les tarifs &amp; disponibilités</a>
      </div>
    </section>
  </div>

  <!-- Bandeau conversion sticky mobile -->
  <div class="fixed inset-x-0 bottom-0 z-30 border-t border-border bg-surface p-3 shadow-lg md:hidden">
    <a href="/reserver/" data-analytics-event="cta_reserver_clic" class="block w-full rounded-md bg-accent py-3 text-center text-sm font-semibold text-white">
      Réserver
    </a>
  </div>
</BaseLayout>
