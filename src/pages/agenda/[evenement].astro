---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { agenda } from '@/data/agenda';
import { withBase } from '@/lib/base-path';
import { buildDate, formatDateLocale } from '@/lib/build-date';

export function getStaticPaths() {
  // Le Festival du Chant de Marin a déjà sa page complète sous /experiences/ —
  // pas de doublon de contenu ici (voir `lienInterne` dans src/data/agenda.ts).
  return agenda.filter((e) => !e.lienInterne).map((e) => ({ params: { evenement: e.slug }, props: { evenement: e } }));
}

const { evenement } = Astro.props as { evenement: (typeof agenda)[number] };
const canonical = new URL(`/agenda/${evenement.slug}/`, Astro.site).toString();

const eventJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: evenement.titre,
  description: evenement.essentiel,
  url: canonical,
  location: { '@type': 'Place', name: evenement.lieu },
  ...(evenement.date ? { startDate: evenement.date } : {}),
  isAccessibleForFree: evenement.gratuit,
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  eventStatus: 'https://schema.org/EventScheduled',
  dateModified: buildDate.toISOString(),
};
---

<BaseLayout
  title={`${evenement.titre} — ${evenement.lieu}`}
  description={evenement.essentiel}
  crumbs={[{ label: 'Agenda', href: '/agenda/' }, { label: evenement.titre, href: `/agenda/${evenement.slug}/` }]}
  jsonLd={eventJsonLd}
>
  <div class="mx-auto max-w-3xl space-y-10 px-4 py-14 sm:px-6">
    <header>
      <p class="text-xs font-semibold uppercase tracking-wide text-accent">{evenement.categorie} · {evenement.lieu}</p>
      <h1 class="mt-2 font-display text-4xl font-semibold">{evenement.titre}</h1>
    </header>

    <section aria-labelledby="essentiel-titre" class="rounded-lg border border-border bg-surface-alt p-5">
      <h2 id="essentiel-titre" class="text-xs font-semibold uppercase tracking-wide text-ink-muted">L'essentiel</h2>
      <p class="mt-2 text-sm">{evenement.essentiel}</p>
    </section>

    <section aria-labelledby="resume-titre">
      <h2 id="resume-titre" class="sr-only">Résumé factuel</h2>
      <div class="overflow-x-auto rounded-lg border border-border">
        <table class="w-full text-sm">
          <tbody>
            <tr class="border-b border-border">
              <th scope="row" class="w-1/3 bg-surface-alt p-3 text-left text-xs font-semibold uppercase tracking-wide text-ink-muted">Lieu</th>
              <td class="p-3">{evenement.lieu}</td>
            </tr>
            <tr class="border-b border-border">
              <th scope="row" class="bg-surface-alt p-3 text-left text-xs font-semibold uppercase tracking-wide text-ink-muted">Quand</th>
              <td class="p-3">{evenement.date ? formatDateLocale(new Date(`${evenement.date}T00:00:00`), 'fr') : evenement.recurrence}</td>
            </tr>
            <tr>
              <th scope="row" class="bg-surface-alt p-3 text-left text-xs font-semibold uppercase tracking-wide text-ink-muted">Tarif</th>
              <td class="p-3">{evenement.gratuit ? 'Gratuit' : (evenement.prix ?? 'Voir site officiel')}</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="mt-3 text-xs text-ink-muted">Programme et dates à reconfirmer sur le site officiel avant de s'y rendre — les calendriers évoluent d'une année sur l'autre.</p>
    </section>

    <section aria-labelledby="description-titre">
      <h2 id="description-titre" class="font-display text-2xl font-semibold">En savoir plus</h2>
      <p class="mt-4 text-sm leading-relaxed">{evenement.description}</p>
    </section>

    {
      evenement.lienOfficiel && (
        <section class="rounded-lg border border-dashed border-accent bg-accent-soft p-5 text-center">
          <a href={evenement.lienOfficiel} target="_blank" rel="noopener noreferrer nofollow" class="font-semibold text-accent underline hover:no-underline">
            Voir le site officiel ↗
          </a>
        </section>
      )
    }

    <p class="text-xs text-ink-muted">
      Source vérifiée : <a href={evenement.source} target="_blank" rel="noopener noreferrer nofollow" class="underline hover:text-accent">{evenement.source}</a>
    </p>

    <a href={withBase('/agenda/')} class="inline-block text-sm font-semibold text-accent hover:underline">← Retour à l'agenda</a>
  </div>
</BaseLayout>
