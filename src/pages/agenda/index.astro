---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { agenda } from '@/data/agenda';
import { withBase } from '@/lib/base-path';
import { formatDateLocale } from '@/lib/build-date';

const datesFixes = agenda.filter((e) => e.date).sort((a, b) => (a.date! < b.date! ? -1 : 1));
const recurrents = agenda.filter((e) => e.recurrence);
---

<BaseLayout
  title="Agenda du territoire"
  description="Les événements réels du territoire autour de Pleubian et de la Presqu'île sauvage : festival, courses, marchés, concerts — avec dates, lieux et liens vers les sites officiels."
  crumbs={[{ label: 'Agenda', href: '/agenda/' }]}
>
  <div class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
    <header>
      <h1 class="font-display text-4xl font-semibold">Agenda du territoire</h1>
      <p class="mt-3 text-ink-muted">
        Des événements réels, vérifiés, avec leurs dates et un lien vers la source officielle — jamais de programme inventé. Dates à reconfirmer avant de s'y rendre : les calendriers évoluent d'une année sur l'autre.
      </p>
    </header>

    <section aria-labelledby="dates-titre" class="mt-10">
      <h2 id="dates-titre" class="font-display text-2xl font-semibold">Dates à venir</h2>
      <ul class="mt-4 space-y-3">
        {
          datesFixes.map((e) => (
            <li>
              <a href={e.lienInterne ? withBase(e.lienInterne) : withBase(`/agenda/${e.slug}/`)} class="block rounded-lg border border-border bg-surface p-4 hover:bg-surface-alt">
                <p class="text-xs font-semibold uppercase tracking-wide text-accent">
                  {e.categorie} · {formatDateLocale(new Date(`${e.date}T00:00:00`), 'fr')}
                </p>
                <p class="mt-1 font-display font-semibold">
                  {e.titre} — {e.lieu}
                </p>
                <p class="mt-1 text-sm text-ink-muted">{e.essentiel}</p>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section aria-labelledby="recurrents-titre" class="mt-12">
      <h2 id="recurrents-titre" class="font-display text-2xl font-semibold">Rendez-vous réguliers</h2>
      <ul class="mt-4 space-y-3">
        {
          recurrents.map((e) => (
            <li>
              <a href={withBase(`/agenda/${e.slug}/`)} class="block rounded-lg border border-border bg-surface p-4 hover:bg-surface-alt">
                <p class="text-xs font-semibold uppercase tracking-wide text-accent">{e.categorie} · {e.recurrence}</p>
                <p class="mt-1 font-display font-semibold">
                  {e.titre} — {e.lieu}
                </p>
                <p class="mt-1 text-sm text-ink-muted">{e.essentiel}</p>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</BaseLayout>
