---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { maison } from '@/data/maison';
import { pratiqueContent } from '@/i18n/pages/pratique';
import { translateItem, equipementItems } from '@/i18n/pages/la-maison';
import { sectionPath, sectionSlug, type Locale } from '@/i18n/locales';

export interface Props {
  locale: Locale;
  alternates: Partial<Record<Locale, string>>;
}

const { locale, alternates } = Astro.props;
const dict = pratiqueContent[locale];
const emplacements = maison.stationnement.emplacements.map((e) => translateItem(e, equipementItems, locale)).join(locale === 'en' ? ' or ' : locale === 'de' ? ' oder ' : ' ou ');
const modalite = translateItem(maison.acces.modalite, equipementItems, locale);

const faq = dict.faq(maison.horaires.arriveeBasseSaison, maison.horaires.arriveeHauteSaison, maison.horaires.depart, maison.animaux.acceptes, emplacements);

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.r },
  })),
};
---

<BaseLayout
  title={dict.titre}
  description={dict.metaDescription}
  crumbs={[{ label: dict.titre, href: `${sectionPath('la-maison', locale)}${sectionSlug('pratique', locale)}/` }]}
  jsonLd={faqJsonLd}
  locale={locale}
  alternates={alternates}
>
  <div class="mx-auto max-w-3xl space-y-16 px-4 py-12 sm:px-6">
    <header>
      <h1 class="font-display text-4xl font-semibold">{dict.titre}</h1>
      <p class="mt-3 text-ink-muted">{dict.intro}</p>
    </header>

    <section aria-labelledby="arrivee-titre">
      <h2 id="arrivee-titre" class="font-display text-2xl font-semibold">{dict.arriveeTitre}</h2>
      <dl class="mt-4 divide-y divide-border rounded-lg border border-border">
        <div class="flex justify-between gap-4 p-4 text-sm">
          <dt class="font-semibold">{dict.arriveeBasse}</dt>
          <dd>{maison.horaires.arriveeBasseSaison}</dd>
        </div>
        <div class="flex justify-between gap-4 p-4 text-sm">
          <dt class="font-semibold">{dict.arriveeHaute}</dt>
          <dd>{maison.horaires.arriveeHauteSaison}</dd>
        </div>
        <div class="flex justify-between gap-4 p-4 text-sm">
          <dt class="font-semibold">{dict.depart}</dt>
          <dd>{maison.horaires.depart}</dd>
        </div>
        <div class="flex justify-between gap-4 p-4 text-sm">
          <dt class="font-semibold">{dict.modalite}</dt>
          <dd>{modalite}</dd>
        </div>
      </dl>
    </section>

    <section aria-labelledby="reglement-titre">
      <h2 id="reglement-titre" class="font-display text-2xl font-semibold">{dict.reglementTitre}</h2>
      <ul class="mt-4 space-y-2 text-sm">
        {dict.reglement.map((item) => <li>· {item}</li>)}
        <li class="text-ink-muted">
          {dict.reglementNote} <a href={sectionPath('reserver', locale)} class="underline hover:text-accent">{dict.reglementLien}</a>.
        </li>
      </ul>
    </section>

    <section aria-labelledby="faq-titre">
      <h2 id="faq-titre" class="font-display text-2xl font-semibold">{dict.faqTitre}</h2>
      <div class="mt-4 divide-y divide-border rounded-lg border border-border">
        {
          faq.map((item) => (
            <details class="group p-4">
              <summary class="cursor-pointer list-none font-semibold marker:content-none">
                {item.q}
              </summary>
              <p class="mt-2 text-sm text-ink-muted">{item.r}</p>
            </details>
          ))
        }
      </div>
    </section>
  </div>
</BaseLayout>
