---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Cta from '@/components/Cta.astro';
import SeasonOfferBanner from '@/components/SeasonOfferBanner.astro';
import { maison } from '@/data/maison';
import { reserverContent } from '@/i18n/pages/reserver';
import { sectionPath, type Locale } from '@/i18n/locales';

export interface Props {
  locale: Locale;
  alternates: Partial<Record<Locale, string>>;
}

const { locale, alternates } = Astro.props;
const dict = reserverContent[locale];

const faq = dict.faq(maison.horaires.arriveeBasseSaison, maison.horaires.arriveeHauteSaison, maison.horaires.depart, maison.animaux.acceptes);
const conditions = dict.conditions(maison.horaires.arriveeBasseSaison, maison.horaires.arriveeHauteSaison, maison.horaires.depart);

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.r },
  })),
};
---

<BaseLayout
  title={dict.titre}
  description={dict.metaDescription(maison.nom, maison.capacite.voyageurs, maison.adresse.commune)}
  crumbs={[{ label: dict.titre, href: sectionPath('reserver', locale) }]}
  jsonLd={faqJsonLd}
  locale={locale}
  alternates={alternates}
>
  <div class="mx-auto max-w-3xl space-y-16 px-4 py-12 sm:px-6">
    <header>
      <h1 class="font-display text-4xl font-semibold">{dict.titre}</h1>
      <p class="mt-3 text-ink-muted">{dict.intro}</p>
      <div class="mt-6">
        <Cta campagne="reserver-page" locale={locale} />
      </div>
      <div class="mt-6">
        <SeasonOfferBanner locale={locale} />
      </div>
    </header>

    <!-- Calendrier de disponibilité -->
    <section aria-labelledby="dispo-titre" class="rounded-lg border border-dashed border-border p-6">
      <h2 id="dispo-titre" class="font-display text-xl font-semibold">{dict.dispoTitre}</h2>
      <p class="mt-2 text-sm text-ink-muted">
        {dict.dispoTexte} <a href={sectionPath('contact', locale)} class="underline hover:text-accent">{dict.dispoContact}</a>.
      </p>
    </section>

    <!-- Tarifs -->
    <section aria-labelledby="tarifs-titre">
      <h2 id="tarifs-titre" class="font-display text-2xl font-semibold">{dict.tarifsTitre}</h2>
      <p class="mt-2 text-sm text-ink-muted">{maison.tarifs.noteTodo}</p>
      <dl class="mt-4 divide-y divide-border rounded-lg border border-border">
        {
          Object.entries(maison.tarifs.parSaison).map(([saison, tarif]) => (
            <div class="flex justify-between gap-4 p-4 text-sm">
              <dt class="font-semibold">{dict.saisonLabels[saison] ?? saison}</dt>
              <dd class="text-ink-muted">{tarif ?? dict.tarifsAVenir}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <!-- Conditions -->
    <section aria-labelledby="conditions-titre">
      <h2 id="conditions-titre" class="font-display text-2xl font-semibold">{dict.conditionsTitre}</h2>
      <ul class="mt-4 space-y-2 text-sm text-ink-muted">
        {conditions.map((c) => <li>· {c}</li>)}
      </ul>
    </section>

    <!-- FAQ -->
    <section aria-labelledby="faq-titre">
      <h2 id="faq-titre" class="font-display text-2xl font-semibold">{dict.faqTitre}</h2>
      <div class="mt-4 divide-y divide-border rounded-lg border border-border">
        {
          faq.map((item) => (
            <details class="group p-4">
              <summary class="cursor-pointer list-none font-semibold marker:content-none">{item.q}</summary>
              <p class="mt-2 text-sm text-ink-muted">{item.r}</p>
            </details>
          ))
        }
      </div>
    </section>

    <section class="rounded-xl bg-accent px-6 py-10 text-center text-white">
      <h2 class="font-display text-2xl font-semibold">{dict.conversionTitre}</h2>
      <div class="mt-6 flex justify-center">
        <Cta campagne="reserver-page-footer" variant="on-accent" locale={locale} />
      </div>
    </section>
  </div>
</BaseLayout>
