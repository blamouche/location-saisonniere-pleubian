---
import { saisons } from '@/data/saisons';
import { enCeMoment } from '@/data/en-ce-moment';
import { saisonLabels, saisonPromesses, saisonPeriodes, type Locale } from '@/i18n/locales';

export interface Props {
  /** Niveau de titre à utiliser (la page ne doit avoir qu'un seul h1 — US-004). */
  headingLevel?: 'h2' | 'h3';
  locale?: Locale;
}

const { headingLevel = 'h2', locale = 'fr' } = Astro.props;
const Titre = headingLevel;
const titreEnCeMoment: Record<Locale, string> = {
  fr: 'En ce moment sur la Presqu’île',
  en: 'Right now on the peninsula',
  de: 'Gerade jetzt auf der Halbinsel',
};
---

<div data-en-ce-moment>
  {
    saisons.map((s) => (
      <div data-season-panel={s.id}>
        <Titre class="font-display text-2xl font-semibold">{titreEnCeMoment[locale]} — {saisonLabels[s.id][locale].toLowerCase()}</Titre>
        <p class="mt-1 text-sm text-ink-muted">{saisonPromesses[s.id][locale]} ({saisonPeriodes[s.id][locale]})</p>
        <ul class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {enCeMoment[locale][s.id].map((sugg) => (
            <li class="rounded-lg border border-border bg-surface p-4">
              <p class="font-display font-semibold">{sugg.titre}</p>
              <p class="mt-1 text-sm text-ink-muted">{sugg.description}</p>
            </li>
          ))}
        </ul>
      </div>
    ))
  }
</div>
