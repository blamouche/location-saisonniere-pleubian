---
import { maison } from '@/data/maison';

const annee = new Date().getFullYear();
---

<footer class="mt-24 border-t border-border bg-surface-alt">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-12 sm:px-6 md:grid-cols-3">
    <div>
      <p class="font-display text-lg font-semibold">{maison.nom}</p>
      <p class="mt-2 text-sm text-ink-muted">
        {maison.adresse.lieuDit}, {maison.adresse.commune} ({maison.adresse.codePostal}) — {maison.adresse.territoire}
      </p>
      <p class="mt-2 text-sm text-ink-muted">Accueil par {maison.hotes.map((h) => h.prenom).join(' & ')}{maison.superhost && ' · Superhost'}</p>
    </div>

    <nav aria-label="Liens utiles" class="text-sm">
      <p class="font-semibold">Liens utiles</p>
      <ul class="mt-2 space-y-1">
        <li><a href="/la-maison/" class="hover:text-accent">La maison</a></li>
        <li><a href="/experiences/" class="hover:text-accent">Expériences</a></li>
        <li><a href="/decouvrir/" class="hover:text-accent">Découvrir</a></li>
        <li><a href="/journal/" class="hover:text-accent">Journal</a></li>
        <li><a href="/avis/" class="hover:text-accent">Avis voyageurs</a></li>
        <li><a href="/reserver/" class="hover:text-accent">Réserver</a></li>
        <li><a href="/contact/" class="hover:text-accent">Contact</a></li>
        <li><a href="/legal/" class="hover:text-accent">Mentions légales &amp; confidentialité</a></li>
      </ul>
    </nav>

    <div>
      <p class="font-semibold">Les 4 saisons de la Presqu'île</p>
      <p class="mt-2 text-sm text-ink-muted">Un email par saison, jamais plus. Pas de spam, désinscription en un clic.</p>
      <!--
        US-026 : UI prête, intégration Buttondown/Brevo réelle à brancher (clé API,
        double opt-in) — voir docs/user-stories.md US-026. Le formulaire est
        fonctionnel côté HTML mais n'envoie nulle part tant que l'action n'est pas
        renseignée.
      -->
      <form class="mt-3 flex gap-2" data-newsletter-form>
        <label for="footer-newsletter-email" class="sr-only">Adresse email</label>
        <input
          id="footer-newsletter-email"
          type="email"
          name="email"
          required
          placeholder="vous@exemple.com"
          class="w-full rounded-md border border-border bg-surface px-3 py-2 text-sm"
        />
        <button type="submit" class="shrink-0 rounded-md bg-accent px-4 py-2 text-sm font-semibold text-white hover:opacity-90">
          S'inscrire
        </button>
      </form>
      <p class="mt-2 text-xs text-ink-muted" data-newsletter-status role="status"></p>
    </div>
  </div>

  <div class="border-t border-border px-4 py-4 text-center text-xs text-ink-muted sm:px-6">
    © {annee} {maison.nom} · <a href="/legal/" class="underline hover:text-accent">Mentions légales</a>
  </div>
</footer>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-newsletter-form]');
  const status = document.querySelector<HTMLElement>('[data-newsletter-status]');

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    // TODO US-026 : brancher Buttondown/Brevo (double opt-in RGPD). En attendant,
    // on ne prétend pas avoir inscrit l'email.
    if (status) {
      status.textContent = "Inscription bientôt disponible — l'intégration newsletter arrive prochainement.";
    }
    window.dispatchEvent(new CustomEvent('analytics', { detail: { event: 'inscription_newsletter_tentative' } }));
  });
</script>
