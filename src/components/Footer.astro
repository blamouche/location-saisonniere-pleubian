---
import { maison } from '@/data/maison';
import { sectionPath, type Locale } from '@/i18n/locales';
import { t } from '@/i18n/dictionary';

export interface Props {
  locale?: Locale;
}

const { locale = 'fr' } = Astro.props;
const dict = t(locale);
const annee = new Date().getFullYear();
---

<footer class="mt-24 border-t border-border bg-surface-alt">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-12 sm:px-6 md:grid-cols-3">
    <div>
      <p class="font-display text-lg font-semibold">{maison.nom}</p>
      <p class="mt-2 text-sm text-ink-muted">
        {maison.adresse.lieuDit}, {maison.adresse.commune} ({maison.adresse.codePostal}) — {maison.adresse.territoire}
      </p>
      <p class="mt-2 text-sm text-ink-muted">
        {dict.footer.accueilPar} {maison.hotes.map((h) => h.prenom).join(' & ')}{maison.superhost && ' · Superhost'}
      </p>
    </div>

    <nav aria-label="Liens utiles" class="text-sm">
      <p class="font-semibold">{dict.footer.liensUtiles}</p>
      <ul class="mt-2 space-y-1">
        <li><a href={sectionPath('la-maison', locale)} class="hover:text-accent">{dict.nav.laMaison}</a></li>
        {locale === 'fr' && <li><a href={sectionPath('experiences', locale)} class="hover:text-accent">{dict.nav.experiences}</a></li>}
        {locale === 'fr' && <li><a href={sectionPath('decouvrir', locale)} class="hover:text-accent">{dict.nav.decouvrir}</a></li>}
        {locale === 'fr' && <li><a href={sectionPath('agenda', locale)} class="hover:text-accent">{dict.nav.agenda}</a></li>}
        {locale === 'fr' && <li><a href={sectionPath('journal', locale)} class="hover:text-accent">{dict.nav.journal}</a></li>}
        {locale === 'fr' && <li><a href={sectionPath('avis', locale)} class="hover:text-accent">{dict.footer.avis}</a></li>}
        <li><a href={sectionPath('reserver', locale)} class="hover:text-accent">{dict.nav.reserver}</a></li>
        <li><a href={sectionPath('contact', locale)} class="hover:text-accent">{dict.nav.contact}</a></li>
        <li><a href={sectionPath('legal', locale)} class="hover:text-accent">{dict.footer.legal}</a></li>
      </ul>
    </nav>

    <div>
      <p class="font-semibold">{dict.footer.newsletterTitre}</p>
      <p class="mt-2 text-sm text-ink-muted">{dict.footer.newsletterTexte}</p>
      <!--
        US-026 : UI prête, intégration Buttondown/Brevo réelle à brancher (clé API,
        double opt-in) — voir documentation/user-stories.md US-026. Le formulaire est
        fonctionnel côté HTML mais n'envoie nulle part tant que l'action n'est pas
        renseignée.
      -->
      <form class="mt-3 flex gap-2" data-newsletter-form data-newsletter-status-text={dict.footer.newsletterStatut}>
        <label for="footer-newsletter-email" class="sr-only">Email</label>
        <input
          id="footer-newsletter-email"
          type="email"
          name="email"
          required
          placeholder={dict.footer.newsletterPlaceholder}
          class="w-full rounded-md border border-border bg-surface px-3 py-2 text-sm"
        />
        <button type="submit" class="shrink-0 rounded-md bg-accent px-4 py-2 text-sm font-semibold text-white hover:opacity-90">
          {dict.footer.newsletterBouton}
        </button>
      </form>
      <p class="mt-2 text-xs text-ink-muted" data-newsletter-status role="status"></p>
    </div>
  </div>

  <div class="border-t border-border px-4 py-4 text-center text-xs text-ink-muted sm:px-6">
    © {annee} {maison.nom} · <a href={sectionPath('legal', locale)} class="underline hover:text-accent">{dict.footer.mentionsLegales}</a>
  </div>
</footer>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-newsletter-form]');
  const status = document.querySelector<HTMLElement>('[data-newsletter-status]');

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    // TODO US-026 : brancher Buttondown/Brevo (double opt-in RGPD). En attendant,
    // on ne prétend pas avoir inscrit l'email.
    if (status) {
      status.textContent = form.dataset.newsletterStatusText ?? '';
    }
    window.dispatchEvent(new CustomEvent('analytics', { detail: { event: 'inscription_newsletter_tentative' } }));
  });
</script>
