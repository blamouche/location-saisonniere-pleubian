---
import { maison } from '@/data/maison';
import SeasonSwitcher from '@/components/SeasonSwitcher.astro';
import LanguageSwitcher from '@/components/LanguageSwitcher.astro';
import { homePath, sectionPath, type Locale } from '@/i18n/locales';
import { t } from '@/i18n/dictionary';

export interface Props {
  locale?: Locale;
  alternates?: Partial<Record<Locale, string>>;
}

const { locale = 'fr', alternates = {} } = Astro.props;
const dict = t(locale).nav;

// Expériences/Découvrir : encore FR uniquement (Lot 5 en cours, US-062/063) — masqués
// en EN/DE plutôt que de pointer vers du contenu inexistant (US-064).
const nav = [
  { href: homePath(locale), label: dict.accueil },
  { href: sectionPath('la-maison', locale), label: dict.laMaison },
  ...(locale === 'fr' ? [{ href: sectionPath('experiences', locale), label: dict.experiences }] : []),
  ...(locale === 'fr' ? [{ href: sectionPath('decouvrir', locale), label: dict.decouvrir }] : []),
  { href: sectionPath('saisons', locale), label: dict.saisons },
  ...(locale === 'fr' ? [{ href: sectionPath('journal', locale), label: dict.journal }] : []),
  { href: sectionPath('reserver', locale), label: dict.reserver },
  { href: sectionPath('contact', locale), label: dict.contact },
];

const current = new URL(Astro.request.url).pathname;
---

<header class="border-b border-border bg-surface/95 backdrop-blur sticky top-0 z-40">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3 sm:px-6">
    <a href={homePath(locale)} class="font-display text-lg font-semibold tracking-tight">
      {maison.nom}
    </a>

    <button
      id="nav-toggle"
      type="button"
      class="inline-flex items-center justify-center rounded-md border border-border p-2 md:hidden"
      aria-expanded="false"
      aria-controls="primary-nav"
    >
      <span class="sr-only">{dict.ouvrirMenu}</span>
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>

    <nav id="primary-nav" aria-label="Navigation principale" class="hidden md:flex md:items-center md:gap-6">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class="text-sm font-medium hover:text-accent"
            aria-current={current === item.href ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
      <SeasonSwitcher locale={locale} />
      <LanguageSwitcher locale={locale} alternates={alternates} />
      <a
        href={sectionPath('reserver', locale)}
        class="rounded-md bg-accent px-4 py-2 text-sm font-semibold text-white hover:opacity-90"
      >
        {dict.ctaDisponibilites}
      </a>
    </nav>
  </div>

  <!-- Drawer mobile -->
  <div id="nav-drawer" class="hidden border-t border-border bg-surface md:hidden" role="dialog" aria-modal="true" aria-label="Menu">
    <nav aria-label="Navigation principale (mobile)" class="flex flex-col gap-1 px-4 py-3">
      {
        nav.map((item) => (
          <a href={item.href} class="rounded-md px-3 py-3 text-base font-medium hover:bg-surface-alt" aria-current={current === item.href ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
      <div class="mt-2">
        <SeasonSwitcher idSuffix="mobile" locale={locale} />
      </div>
      <div class="mt-2">
        <LanguageSwitcher idSuffix="mobile" locale={locale} alternates={alternates} />
      </div>
      <a href={sectionPath('reserver', locale)} class="mt-2 rounded-md bg-accent px-3 py-3 text-center text-base font-semibold text-white">
        {dict.ctaDisponibilites}
      </a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const drawer = document.getElementById('nav-drawer');

  toggle?.addEventListener('click', () => {
    const expanded = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!expanded));
    drawer?.classList.toggle('hidden');
  });

  function fermerDrawer() {
    drawer?.classList.add('hidden');
    toggle?.setAttribute('aria-expanded', 'false');
  }

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && drawer && !drawer.classList.contains('hidden')) {
      fermerDrawer();
      (toggle as HTMLElement | null)?.focus();
    }
  });

  // Clic en dehors du drawer (et de son bouton d'ouverture) : on referme.
  document.addEventListener('click', (event) => {
    if (!drawer || drawer.classList.contains('hidden')) return;
    const target = event.target as Node;
    if (!drawer.contains(target) && !toggle?.contains(target)) {
      fermerDrawer();
    }
  });
</script>
