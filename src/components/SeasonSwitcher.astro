---
import { saisons, getSaisonCourante } from '@/data/saisons';
import { saisonLabels, saisonPeriodes, type Locale } from '@/i18n/locales';
import { t } from '@/i18n/dictionary';
import { formatDateLocale } from '@/lib/build-date';

export interface Props {
  /** Suffixe d'id, nécessaire si le composant est utilisé plusieurs fois sur une
   * même page (desktop + drawer mobile) pour éviter les id dupliqués. */
  idSuffix?: string;
  locale?: Locale;
}

const { idSuffix = 'desktop', locale = 'fr' } = Astro.props;
const menuId = `season-switcher-menu-${idSuffix}`;
const toggleId = `season-switcher-toggle-${idSuffix}`;
const dict = t(locale).seasonSwitcher;
const label = (id: string) => saisonLabels[id]?.[locale] ?? id;

const reelle = getSaisonCourante();
const aujourdhui = formatDateLocale(new Date(), locale);
---

<div class="relative" data-season-switcher>
  <button
    type="button"
    id={toggleId}
    data-season-switcher-toggle
    aria-haspopup="true"
    aria-expanded="false"
    aria-controls={menuId}
    class="flex items-center gap-1 rounded-md border border-border px-3 py-2 text-sm font-medium hover:bg-surface-alt"
  >
    {dict.intro} <span data-season-switcher-label class="font-semibold">{label(reelle.id)}</span>
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
  </button>

  <div id={menuId} data-season-switcher-menu role="menu" aria-label="Choisir la saison affichée" class="absolute right-0 z-50 mt-2 hidden w-72 rounded-lg border border-border bg-surface p-2 shadow-lg">
    <ul class="space-y-1">
      {
        saisons.map((s) => (
          <li>
            <button
              type="button"
              role="menuitemradio"
              data-season-option={s.id}
              aria-checked={s.id === reelle.id ? 'true' : 'false'}
              class="flex w-full items-center justify-between rounded-md px-3 py-2 text-left text-sm hover:bg-surface-alt"
            >
              <span>
                <span class="font-semibold">{label(s.id)}</span>
                <span class="block text-xs text-ink-muted">{saisonPeriodes[s.id][locale]}</span>
              </span>
              {s.id === reelle.id && <span class="text-xs font-semibold text-accent">{dict.current}</span>}
            </button>
          </li>
        ))
      }
    </ul>
    <p class="mt-2 border-t border-border px-3 pt-2 text-xs text-ink-muted">
      {dict.today(aujourdhui, label(reelle.id).toLowerCase())}
      <a href={locale === 'fr' ? '/reserver/' : `/${locale}/${locale === 'en' ? 'book' : 'buchen'}/`} class="underline hover:text-accent">{dict.checkCalendar}</a>.
    </p>
  </div>
</div>

<script>
  // Gère toutes les instances du switcher présentes sur la page (desktop + drawer
  // mobile) — Astro ne rend ce bloc <script> qu'une seule fois par page même si le
  // composant est utilisé plusieurs fois.
  const wrappers = Array.from(document.querySelectorAll<HTMLElement>('[data-season-switcher]'));

  function fermer(wrapper: HTMLElement) {
    const toggle = wrapper.querySelector<HTMLElement>('[data-season-switcher-toggle]');
    const menu = wrapper.querySelector<HTMLElement>('[data-season-switcher-menu]');
    menu?.classList.add('hidden');
    toggle?.setAttribute('aria-expanded', 'false');
  }

  function fermerToutes() {
    wrappers.forEach(fermer);
  }

  function synchroniser(id: string) {
    document.documentElement.setAttribute('data-season', id);
    try {
      localStorage.setItem('saison-preference', id);
    } catch (e) {
      /* localStorage indisponible : le choix ne survivra pas au rechargement. */
    }
    wrappers.forEach((wrapper) => {
      const label = wrapper.querySelector<HTMLElement>('[data-season-switcher-label]');
      const options = Array.from(wrapper.querySelectorAll<HTMLButtonElement>('[data-season-option]'));
      options.forEach((btn) => {
        const isMatch = btn.dataset.seasonOption === id;
        btn.setAttribute('aria-checked', isMatch ? 'true' : 'false');
        if (isMatch && label) label.textContent = btn.querySelector('span > span')?.textContent ?? id;
      });
    });
  }

  wrappers.forEach((wrapper) => {
    const toggle = wrapper.querySelector<HTMLElement>('[data-season-switcher-toggle]');
    const menu = wrapper.querySelector<HTMLElement>('[data-season-switcher-menu]');
    const options = Array.from(wrapper.querySelectorAll<HTMLButtonElement>('[data-season-option]'));

    toggle?.addEventListener('click', () => {
      const ouvert = toggle.getAttribute('aria-expanded') === 'true';
      fermerToutes();
      if (!ouvert) {
        menu?.classList.remove('hidden');
        toggle.setAttribute('aria-expanded', 'true');
      }
    });

    options.forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = btn.dataset.seasonOption!;
        synchroniser(id);
        fermerToutes();
        window.dispatchEvent(new CustomEvent('analytics', { detail: { event: 'changement_saison', props: { saison: id } } }));
      });
    });
  });

  document.addEventListener('click', (event) => {
    wrappers.forEach((wrapper) => {
      if (!wrapper.contains(event.target as Node)) fermer(wrapper);
    });
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    wrappers.forEach((wrapper) => {
      const toggle = wrapper.querySelector<HTMLElement>('[data-season-switcher-toggle]');
      const menu = wrapper.querySelector<HTMLElement>('[data-season-switcher-menu]');
      if (menu && !menu.classList.contains('hidden')) {
        fermer(wrapper);
        toggle?.focus();
      }
    });
  });
</script>
