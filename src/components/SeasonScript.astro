---
/**
 * Script anti-flash (US-031, PRD §6.4) : corrige `data-season` sur <html> côté
 * client, avant peinture, si le build affiché est trop ancien (>24h — pas de
 * rebuild quotidien réellement programmé, voir US-032) pour refléter la saison
 * réelle du jour. Purement automatique, déterminé par la date — aucun réglage
 * manuel proposé au visiteur (pas de sélecteur, pas de préférence mémorisée).
 *
 * Doit rester **synchrone** (pas de `defer`/`async`) et placé tôt dans <head>
 * pour s'exécuter avant la première peinture (pas de flash de contenu).
 * Volontairement minimal : < 2 ko (contrainte US-031).
 */
---

<script is:inline>
  (function () {
    var SAISONS = [
      { id: 'printemps', debut: 3, fin: 5 },
      { id: 'ete', debut: 6, fin: 8 },
      { id: 'automne', debut: 9, fin: 11 },
      { id: 'hiver', debut: 12, fin: 2 },
    ];

    function saisonDuMois(mois) {
      for (var i = 0; i < SAISONS.length; i++) {
        var s = SAISONS[i];
        if (s.debut <= s.fin ? mois >= s.debut && mois <= s.fin : mois >= s.debut || mois <= s.fin) return s.id;
      }
      return 'ete';
    }

    var html = document.documentElement;
    var builtAt = Number(html.getAttribute('data-built-at') || 0);
    if (!builtAt || Date.now() - builtAt <= 86400000) return;

    var reelle = saisonDuMois(new Date().getMonth() + 1);
    if (reelle !== html.getAttribute('data-season')) {
      html.setAttribute('data-season', reelle);
    }
  })();
</script>
