---
export interface Fact {
  label: string;
  value: string;
}

export interface Props {
  facts: Fact[];
  class?: string;
}

const { facts, class: className } = Astro.props;
---

<dl class:list={['grid grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-6', className]}>
  {
    facts.map((fact) => (
      <div class="rounded-lg border border-border bg-surface px-3 py-4 text-center">
        <dt class="text-xs uppercase tracking-wide text-ink-muted">{fact.label}</dt>
        <dd class="mt-1 font-display text-xl font-semibold">{fact.value}</dd>
      </div>
    ))
  }
</dl>
