---
import { saisons } from '@/data/saisons';
import { saisonLabels, type Locale } from '@/i18n/locales';

export interface Props {
  locale?: Locale;
}

const { locale = 'fr' } = Astro.props;

/**
 * Bandeau offre contextualisé à la saison affichée (US-036, Could). Messages
 * qualitatifs uniquement — pas de tarif chiffré inventé, cohérent avec les
 * fourchettes réelles (encore « à venir ») de `/reserver/` (US-019).
 */
const messages: Record<Locale, Record<string, string>> = {
  fr: {
    printemps: 'Tarifs de basse saison — réservez avant la ruée de l’été.',
    ete: 'Haute saison : les disponibilités partent vite, mieux vaut réserver tôt.',
    automne: 'Tarifs de l’arrière-saison — la Presqu’île sans la foule.',
    hiver: 'Longs séjours bienvenus hors saison — nous consulter pour un tarif dégressif.',
  },
  en: {
    printemps: 'Low-season rates — book ahead of the summer rush.',
    ete: 'High season: availability goes fast, better to book early.',
    automne: 'Late-season rates — the peninsula without the crowds.',
    hiver: 'Long stays welcome off-season — ask us about a reduced rate.',
  },
  de: {
    printemps: 'Nebensaison-Preise — vor dem Sommeransturm buchen.',
    ete: 'Hauptsaison: Verfügbarkeiten sind schnell weg, früh buchen lohnt sich.',
    automne: 'Nachsaison-Preise — die Halbinsel ohne die Menschenmassen.',
    hiver: 'Längere Aufenthalte außerhalb der Saison willkommen — fragen Sie nach einem Staffelpreis.',
  },
};
---

<div class="rounded-lg border border-accent bg-accent-soft px-4 py-3 text-sm text-ink">
  {
    saisons.map((s) => (
      <p data-season-panel={s.id}>
        <strong class="font-display">{saisonLabels[s.id][locale]} :</strong> {messages[locale][s.id]}
      </p>
    ))
  }
</div>
